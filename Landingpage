        <h2 id="ekip-title">Biz Kimiz?</h2>
        <div class="small-muted">İnsan odaklı, sonuç odaklı bir ekip</div>
      </div>

      <div class="team">
        <div class="member" role="group" aria-label="Sertan Kırço">
          <div class="avatar">SK</div>
          <div>
            <div style="font-weight:700">Sertan Kırço</div>
            <div class="small" style="margin-top:6px">Dijital Strateji & Marka Danışmanı</div>
          </div>
        </div>

        <div class="member" role="group" aria-label="İçerik & Tasarım">
