        <div class="small-muted">Formu doldurun, 24 saat içinde size dönüş yapalım.</div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 360px;gap:16px;">
        <form id="leadForm" aria-label="Ücretsiz görüşme formu" onsubmit="return handleForm(event)">
          <div class="form-row">
            <div class="col"><label for="name">İsim *</label><input id="name" name="name" required placeholder="Adınız ve soyadınız"></div>
            <div class="col"><label for="phone">Telefon</label><input id="phone" name="phone" placeholder="+90 ..."></div>
          </div>
          <div>
            <label for="email">E-posta *</label>
            <input id="email" type="email" name="email" required placeholder="eposta@ornek.com">
          </div>
          <div>
            <label for="company">Marka / İşletme (opsiyonel)</label>
            <input id="company" name="company" placeholder="Marka adı">
          </div>
          <div>
            <label for="message">Kısa not: Hedefleriniz veya öncelikleriniz</label>
            <textarea id="message" name="message" placeholder="Kısaca hedeflerinizi yazın..."></textarea>
          </div>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <button type="submit" class="btn btn-primary">📩 Görüşme Talep Et</button>
