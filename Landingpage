          <div class="small" style="margin-top:8px">📧 hello@growlabsagency.com<br>📞 +90 (___) ___ __ __<br>📍 Mecidiyeköy, İstanbul</div>
          <div style="margin-top:12px">
            <strong>Hızlı not:</strong>
            <div class="small" style="margin-top:6px;color:var(--muted)">Formu doldurduktan sonra 24 saat içinde size uygun bir zaman aralığı göndeririz.</div>
          </div>
        </aside>
      </div>
    </section>

    <footer role="contentinfo" style="margin-top:28px">
      <div>
        <div style="font-weight:700">GrowLabs Agency</div>
        <div class="small" style="margin-top:6px">Gizlilik politikamız ve KVKK uyumuna önem veriyoruz.</div>
      </div>
      <div style="text-align:right">
        <div style="font-weight:700">Sosyal</div>
        <div class="small" style="margin-top:6px">Instagram · LinkedIn · Facebook</div>
        <div class="small" style="margin-top:10px;color:var(--muted)">© <span id="year"></span> GrowLabs Agency</div>
      </div>
    </footer>
  </div>

  <!-- Minimal JS: form handling, modal mimic + Yeni Slider JS -->
  <script>
    document.getElementById('year').textContent = new Date().getFullYear();

    // Smooth scroll for anchor buttons
    document.querySelectorAll('a[href^="#"]').forEach(a=>{
      a.addEventListener('click', e=>{
        e.preventDefault();
        const id = a.getAttribute('href').slice(1);
        const el = document.getElementById(id);
        if(el) el.scrollIntoView({behavior:'smooth',block:'start'});
      });
    });

    // open form buttons
    document.getElementById('openFormBtn').addEventListener('click', ()=>document.getElementById('iletisim').scrollIntoView({behavior:'smooth'}));
    document.getElementById('openFormBtn2').addEventListener('click', ()=>document.getElementById('iletisim').scrollIntoView({behavior:'smooth'}));
    document.getElementById('caseRequestBtn').addEventListener('click', ()=>alert('Vaka incelemesi talebiniz alındı. En kısa sürede iletişime geçeceğiz.'));

    function handleForm(e){
      e.preventDefault();
      const form = e.target;
      const name = form.name.value.trim();
      const email = form.email.value.trim();
      // Basit doğrulama
      if(!name || !email){ alert('Lütfen isim ve e-posta alanlarını doldurun.'); return false; }

      // Burada: gerçek projede form verisini sunucuya POST et veya 3rd party form action ile bağla.
      // Şimdilik kullanıcıya bilgilendirme gösterelim.
      alert('Teşekkürler ' + (name.split(' ')[0] || '') + '! Talebiniz alındı. 24 saat içinde size ulaşacağız.');

      // Opsiyonel: formu sıfırla
      form.reset();
      return false;
    }

    // Yeni: Interaktif Slider Demo JS
    const sliderTrack = document.getElementById('sliderTrack');
    const slides = document.querySelectorAll('.testimonial-slide');
    const prevBtn = document.getElementById('prevSlide');
    const nextBtn = document.getElementById('nextSlide');
    const sliderNav = document.getElementById('sliderNav');
    let currentSlide = 0;
    let autoSlideInterval;

    // Dots oluştur
    slides.forEach((_, index) => {
      const dot = document.createElement('div');
      dot.classList.add('nav-dot');
      if (index === 0) dot.classList.add('active');
      dot.addEventListener('click', () => goToSlide(index));
      sliderNav.appendChild(dot);
    });
    const dots = document.querySelectorAll('.nav-dot');

    function updateSlider() {
      sliderTrack.style.transform = `translateX(-${currentSlide * 100}%)`;
      slides.forEach((slide, i) => slide.classList.toggle('active', i === currentSlide));
      dots.forEach((dot, i) => dot.classList.toggle('active', i === currentSlide));
    }

    function goToSlide(n) {
      currentSlide = n;
      updateSlider();
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      updateSlider();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + slides.length) % slides.length;
      updateSlider();
    }

    // Otomatik play (3 sn'de bir)
    function startAutoSlide() {
      autoSlideInterval = setInterval(nextSlide, 3000);
    }

    function stopAutoSlide() {
      clearInterval(autoSlideInterval);
    }

    // Event listeners
    nextBtn.addEventListener('click', nextSlide);
    prevBtn.addEventListener('click', prevSlide);
    sliderTrack.addEventListener('mouseenter', stopAutoSlide);
    sliderTrack.addEventListener('mouseleave', startAutoSlide);

    // Klavye desteği (sola/sağa ok)
    document.addEventListener('keydown', (e) => {
      if (document.activeElement.closest('.testimonial-slider')) {
        if (e.key === 'ArrowLeft') prevSlide();
        if (e.key === 'ArrowRight') nextSlide();
      }
    });

    // Başlat
    startAutoSlide();
  </script>
</body>
</html>
