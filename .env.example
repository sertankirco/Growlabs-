# ── Sunucu ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Veritabanı (yoksa in-memory mod) ────────────────────────────────────────
# Üretim ortamı için PostgreSQL önerilir.
# DATABASE_URL=postgres://user:password@localhost:5432/wc2026

# PostgreSQL bağlantı havuzu boyutu (varsayılan: 10)
# PG_POOL_SIZE=10

# ── Güvenlik ─────────────────────────────────────────────────────────────────
# JWT imzalama anahtarı — ÜRETİMDE MUTLAKA DEĞİŞTİRİN
JWT_SECRET=change-me-in-production

# Admin API anahtarı (X-Admin-Secret header)
ADMIN_SECRET=wc2026-admin-change-in-prod

# ── Sportradar Canlı Veri Katmanı (opsiyonel) ─────────────────────────────────
# Ayarlanmazsa simülasyon modunda çalışır — gerçek maç verisi çekilmez.

# Sportradar API anahtarı
# SR_API_KEY=your-sportradar-api-key

# REST polling base URL
# SR_API_BASE_URL=https://api.sportradar.com/soccer/v4

# SSE push stream URL (varsa REST polling'den öncelikli kullanılır)
# SR_PUSH_URL=https://push.sportradar.com/soccer/v4/stream

# WC2026 turnuva kimliği (Sportradar tournament ID)
# SR_TOURNAMENT_ID=sr:tournament:40

# Polling aralığı (ms) — varsayılan 10 saniye
# SR_POLL_INTERVAL_MS=10000
